#!/bin/sh
# push の前に、ひな形（remote の template）の更新を取り込んでいるかを確かめる。
# 取り込んでいない更新があれば、push を止める。
# 判断: template/main のコミットが、push するコミットの履歴に入っているか。

# ひな形そのもの（template remote が無いリポジトリ）では何もしない
git remote get-url template >/dev/null 2>&1 || exit 0

# 取得に失敗したとき（オフラインなど）は確かめられないので止めない
git fetch --quiet template main || exit 0

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # ブランチを消す push は確かめない
  [ "$local_sha" = "$zero" ] && continue

  count=$(git rev-list --count "$local_sha..template/main")
  [ "$count" -eq 0 ] && continue

  echo "push を止めました: ひな形に、${local_ref#refs/heads/} へ取り込んでいない更新が ${count} 件あります。" >&2
  git log --format='  - %s' "$local_sha..template/main" >&2
  status=1
done

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "取り込んでから、もう一度 push してください（docs/gitの使い方.md の「ひな形の更新を取り込む」）。" >&2
  echo "  git merge template/main" >&2
fi
exit "$status"
